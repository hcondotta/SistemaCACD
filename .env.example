# Copie este arquivo para .env.local e preencha. O .env.local NUNCA vai para o git.

# ----------------------------------------------------------------------------
# Supabase (PostgreSQL + pgvector)
# Painel do projeto > Settings > API
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"

# Chave pública: vai para o bundle do navegador por construção.
# Nenhuma proteção do sistema pode depender dela ser secreta — quem protege é o RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anon"

# Chave de serviço: IGNORA o RLS. Exclusiva de servidor (Server Components,
# Route Handlers e back-office Python). Nunca referencie em código "use client".
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role"

# ----------------------------------------------------------------------------
# Google Gemini (RAG, síntese de aulas, correção de discursivas)
# https://aistudio.google.com/apikey
# ----------------------------------------------------------------------------
GEMINI_API_KEY="sua-chave-gemini"
